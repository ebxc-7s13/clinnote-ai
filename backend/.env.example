# ClinNote backend (Supabase Edge Functions) secrets — set with `supabase secrets set`, never commit values.
# Create the Gemini key in a Google Cloud project WITHOUT billing enabled so that no charge is possible.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.7-flash
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
# Hard free-only switch; the functions refuse to run when this is not "true".
FREE_ONLY_MODE=true
# R2 possibilities (ADR-025): default false. Only "true" in a development project with synthetic data.
POSSIBILITIES_ENABLED=false
# Optional NCBI E-utilities key (not used by the app in V1; device calls stay within the keyless limit).
NCBI_API_KEY=
