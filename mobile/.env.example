# ClinNote mobile app — PUBLIC configuration only. Never put a private key here: EXPO_PUBLIC_* values are
# compiled into the APK. The Supabase anon key is a public key by design; the Gemini key lives only in the backend.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Optional: contact email sent to NCBI E-utilities as the "email" parameter (NCBI usage policy).
EXPO_PUBLIC_NCBI_EMAIL=
# development | preview | production  (R2 possibilities can only be enabled in development/preview builds)
EXPO_PUBLIC_APP_VARIANT=development
